<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="ParentForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ComparserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="SettingsControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="ParentControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="MenuControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="ExpressionControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Comparser\Gpu\" />
  </ItemGroup>

</Project>